import "Time.so" as Time end
import "Random.so" as Random end
import "../tableSum.bs" as tableSum end
require "benchmark.bs" as Function benchmark end


func Number speedTest()
    import "Time.so" as Time end
    import "Random.so" as Random end
    import "../tableSum.bs" as tableSum end

    Number tests = 100000
    Table nums = {}
    for i = 0, tests repeat nums:insert(Random:integer(-100000, 100000)) end

    Number pre = Time:clock()
    tableSum:sum(nums)
    Number post = Time:clock()

    return post - pre
end

print("Testing the speed of insertion sort on a table of 100000 random elements")
print(benchmark(speedTest))
